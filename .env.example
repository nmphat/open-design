# Open Design — AI-powered design tool
# Copy to deploy/.env and fill in your values.
# docker-compose.yml reads this via env_file.

# Docker image (default: latest from Docker Hub)
OPEN_DESIGN_IMAGE=docker.io/vanjayak/open-design:latest

# Port exposed on host
OPEN_DESIGN_PORT=7456

# Allowed CORS origins (comma-separated, leave empty for same-origin only)
OPEN_DESIGN_ALLOWED_ORIGINS=

# API token — REQUIRED
# Generate: openssl rand -hex 32
OD_API_TOKEN=your-api-token-here

# Memory limit for container (default: 384m)
OPEN_DESIGN_MEM_LIMIT=384m

# Node.js options
NODE_OPTIONS=--max-old-space-size=192

# Codex sandbox mode (optional)
# OD_CODEX_SANDBOX=
